# ── Ambiguous ────────────────────────────────────────────────────────────────
# Get your ak_ key from https://app.ambiguous.ai → Settings → API Keys
# AMBIGUOUS_RALLY_KEY  : Rally's own provisioned agent key (preferred)
# AMBIGUOUS_API_KEY    : fallback admin key
AMBIGUOUS_RALLY_KEY=ak_...
AMBIGUOUS_API_KEY=ak_...
AMBIGUOUS_MODE=live          # mock | live
AMBIGUOUS_WORKSPACE=team-rocket

# URL shown in the ?split=1 mirror panel (right half of the demo screen)
NEXT_PUBLIC_AMBIGUOUS_WORKSPACE_URL=https://app.ambiguous.ai/team-rocket

# Demo attendee roster — name→email map used for send_mail / file_task resolution.
# JSON object. Add / change to match the actual workspace members.
ATTENDEES_JSON={"Priya":"priya@team-rocket.com","Sam":"sam@team-rocket.com","Alex":"alex@team-rocket.com","Hemanth":"hemanth@team-rocket.com","Aravind":"aravind@team-rocket.com","Sarah":"sarah@team-rocket.com"}

# ── Hermes (from Aravind's A8 — leave blank until he posts SHIPPED) ───────────
HERMES_MODE=canned           # canned | live
HERMES_ENDPOINT=http://localhost:8000
